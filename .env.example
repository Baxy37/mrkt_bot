# Telegram Bot Token
BOT_TOKEN=your_bot_token_here

# MRKT API (замените на реальный URL, если есть)
MRKT_API_URL=https://api.mrkt.io/v1/lots

# Database (SQLite по умолчанию)
DATABASE_URL=sqlite:///app.db

# Интервал сканирования в секундах
SCAN_INTERVAL=10

# Бюджет (максимальная цена лота в USD)
BUDGET_LIMIT=1000.0

# Минимальная прибыль в USD
MIN_PROFIT=50.0

# Минимальный рейтинг сделки (0-100)
MIN_RATING=70

# Чёрный список коллекций через запятую
BLACKLIST_COLLECTIONS=collection1,collection2

# Режим: test, analytics, semiauto
MODE=analytics

# Уровень логирования (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
